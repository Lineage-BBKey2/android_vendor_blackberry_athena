on init
    chown system system /dev/goodix_fp
    chmod 0644 /dev/goodix_fp

on post-fs-data
    mkdir /data/goodix 0700 system system
#    chcon u:object_r:persist_drm_file:s0 /data/goodix
#    setprop goodix.fp.service.ready 0

service gx_fpd /vendor/bin/gx_fpd
    class late_start
    user system
    group system
    disabled

# The AIDL wrapper opens the legacy HAL during startup. Keep it stopped until
# gx_fpd has initialized the Goodix/QSEE stack and published its ready property.
service vendor.fingerprint-default /vendor/bin/hw/android.hardware.biometrics.fingerprint-service.lineage
    override
    class late_start
    user system
    group system input uhid
    shutdown critical
    disabled

on property:sys.boot_completed=1
    start gx_fpd

on property:goodix.fp.service.ready=1
    start vendor.fingerprint-default
